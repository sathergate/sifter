{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.sathergate/sifter",
  "description": "Full-text search for Next.js. BM25 scoring and fuzzy matching, no external service.",
  "version": "0.1.1",
  "repository": {
    "url": "https://github.com/sathergate/sifter",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "sifter-next",
      "version": "0.1.1",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}

{
  "name": "sifter-next",
  "version": "0.1.1",
  "mcpName": "io.github.sathergate/sifter",
  "description": "Full-text search for Next.js. No external service.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "bin": {
    "sifter": "dist/cli.js"
  },
  "files": [
    "dist",
    "server.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "next": ">=14",
    "@modelcontextprotocol/server": ">=2.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/node": "^22.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "zod": "^4.4.3"
  },
  "keywords": [
    "sifter",
    "sifter-next",
    "search",
    "full-text",
    "index",
    "nextjs",
    "react",
    "fuzzy",
    "tfidf",
    "mcp",
    "claude-code",
    "ai-coding",
    "agent-friendly",
    "sathergate-toolkit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sathergate/sifter.git"
  },
  "homepage": "https://github.com/sathergate/sifter#readme",
  "claude": {
    "init": "npx sifter-next init",
    "mcp": true,
    "category": "search",
    "toolkit": {
      "name": "sathergate-toolkit",
      "repo": "https://github.com/sathergate/sathergate-toolkit",
      "packages": [
        "shutterbox",
        "flagpost",
        "ratelimit-next",
        "notifykit",
        "croncall",
        "vaultbox",
        "sifter-next"
      ]
    }
  }
}
